{
  "name": "sokombele",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test lib/engine.test.ts lib/trip.test.ts",
    "data": "node scripts/build-data.ts && .venv/bin/python scripts/model/train.py && node scripts/check-data.ts",
    "data:validate": "VALIDATE=1 node scripts/build-data.ts && .venv/bin/python scripts/model/train.py --validate",
    "refresh": "node scripts/refresh.ts",
    "weekly": "node scripts/refresh.ts && pnpm data",
    "model:setup": "python3.13 -m venv .venv && .venv/bin/pip install -r scripts/model/requirements.txt"
  },
  "dependencies": {
    "@headlessui/react": "2.2.9",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4"
}
